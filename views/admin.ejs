<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Page</title>
    <!-- Add Bootstrap CSS link -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
   
</head>
<body>
    <div class="container mt-5">
        <h2 class="text-dark

        ">Add User:</h2>
        <form action="/MyGestion-Ocp/admin" method="post" class="needs-validation" novalidate>
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="fullname" class="form-label">Full Name:</label>
                    <input type="text" class="form-control" id="fullname" name="fullname" required>
                    <div class="invalid-feedback">Please enter your full name.</div>
                </div>

                <div class="col-md-6">
                    <label for="poste" class="form-label">Poste:</label>
                    <input type="text" class="form-control" id="poste" name="poste" required>
                    <div class="invalid-feedback">Please enter the poste.</div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label for="email" class="form-label">Email:</label>
                    <input type="email" class="form-control" id="email" name="email" required>
                    <div class="invalid-feedback">Please enter a valid email address.</div>
                </div>

                <div class="col-md-6">
                    <label for="password" class="form-label">Password:</label>
                    <input type="password" class="form-control" id="password" name="password" required>
                    <div class="invalid-feedback">Please enter a password.</div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label for="type" class="form-label">Type:</label>
                    <select class="form-select" id="type" name="type" required onchange="toggleSonApprobateur()">
                        <option value="" selected disabled>Select a type</option>
                        <option value="Approbateur">Responsable</option>
                        <option value="Secretaire">Secrétaire</option>
                    </select>
                    <div class="invalid-feedback">Please select the user type.</div>
                </div>
                <div class="col-md-6" id="sonApprobateurContainer" style="display: none;">
                    <label for="idsecretaire" class="form-label">L'id de son approbateur:</label>
                    <input type="text" class="form-control" id="idsecretaire" name="idsecretaire" value="0" required>
                    <div class="invalid-feedback">Please enter the secretary ID.</div>
                </div>
            </div>

            <button type="submit" class="btn btn-success btn btn-submit mt-3">Add User</button>
        </form>
    </div>



    <div >
        <div class="container-fluid">
          <div class="header-body">
            <div class="row align-items-center py-4">
              <div class="col-lg-6 col-7">
                <h6 class="h2 text-white d-inline-block mb-0">Tables</h6>
                <nav aria-label="breadcrumb" class="d-none d-md-inline-block ml-md-4">
               
                </nav>
              </div>
             
            </div>
          </div>
        </div>
    <!-- Page content -->
  <div class="container-fluid mt--6">
    <div class="row">
      <div class="col">
        <div class="card">
          <!-- Card header -->
          <div class="card-header border-0">
            <h3 class="mb-0">Utilisateurs</h3>
          </div>
          <!-- Light table -->
          <!-- Light table -->
<div class="table-responsive">
    <table id="demandeData" class="table align-items-center table-flush">
        <thead class="thead-light">
            <tr>
                <th scope="col">idUsers</th>
                <th scope="col">fullname</th>
                <th scope="col">poste</th>
                <th scope="col">email</th>
                <th scope="col">password</th>
                <th scope="col">Type</th>
                <th scope="col">Id_approbateur</th>
                <th scope="col">Supprimer</th>

            </tr>
        </thead>
        <!-- Table body -->
        <tbody>
            <% users.forEach(function(user) { %>
                <tr>
                    <td><%= user.idUsers %></td>
                    <td><%= user.fullname %></td>
                    <td><%= user.poste %></td>
                    <td><%= user.email %></td>
                    <td><%= user.password %></td>
                    <td><%= user.type %></td>
                    <td><%= user.idsecretaire %></td>
                    <td>
                        <!-- Add a delete button with a unique identifier (e.g., user ID) -->
                        <button class="btn btn-danger" onclick="deleteUser('<%= user.idUsers %>')">Delete</button>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</div>

    <!-- Add Bootstrap JS and Popper.js scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function toggleSonApprobateur() {
            var typeSelect = document.getElementById("type");
            var sonApprobateurContainer = document.getElementById("sonApprobateurContainer");

            if (typeSelect.value === "Approbateur") {
                sonApprobateurContainer.style.display = "none";
                document.getElementById("idsecretaire").value = "0";
            } else if (typeSelect.value === "Secretaire") {
                sonApprobateurContainer.style.display = "block";
            }
        }
// Function to handle table search
function searchTable() {
    // Get the input value
    var input = document.getElementById('searchInput').value.toLowerCase();

    // Get the table rows
    var rows = document.getElementById('demandeData').getElementsByTagName('tr');

    // Loop through all table rows
    for (var i = 0; i < rows.length; i++) {
        // Get the fullname cell value (assuming it's the first cell in each row)
        var fullnameCell = rows[i].getElementsByTagName('td')[1];

        // Log for debugging
        console.log('Row:', i, ' Fullname Cell:', fullnameCell);

        // If the fullname contains the input value, show the row; otherwise, hide it
        if (fullnameCell) {
            var fullnameText = fullnameCell.textContent || fullnameCell.innerText;
            console.log('Fullname Text:', fullnameText);

            if (fullnameText.toLowerCase().indexOf(input) > -1) {
                rows[i].style.display = '';
            } else {
                rows[i].style.display = 'none';
            }
        }
    }
}

// Attach an event listener to the input element
document.getElementById('searchInput').addEventListener('input', searchTable);



function deleteUser(userId) {
    if (confirm('Are you sure you want to delete this user?')) {
        fetch(`/MyGestion-Ocp/admin/delete/${userId}`, {
            method: 'DELETE',
            headers: {
                'Content-Type': 'application/json',
            },
        })
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! Status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
            if (data.success) {
                const row = document.getElementById(`userRow${userId}`);
                if (row) {
                    row.remove();
                }
                location.reload();
            } else {
                alert('Error deleting user. Server response: ' + JSON.stringify(data));
            }
            
        })
        .catch(error => {
            console.error('Error deleting user:', error.message);
            alert('Error deleting user. Please check the console for details.');
        });
    }
}

    </script>
</body>
</html>
