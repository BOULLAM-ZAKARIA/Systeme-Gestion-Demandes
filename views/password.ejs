<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Password</title>
    <style>


     

        label {
            display: block;
            margin-bottom: 8px;
        }

        input {
            width: 100%;
            padding: 8px;
            margin-bottom: 16px;
            box-sizing: border-box;
        }

        button {
            background-color: #4caf50;
            color: #fff;
            padding: 10px 15px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

        button:hover {
            background-color: #45a049;
        }
        h1 {
            color: #333;
            text-align: center; 
        }
        
    </style>
    <!-- ... (your existing styles) ... -->

</head>
<body>

    <form action="/MyGestion-Ocp/change-password" method="post">
        <h1>Change Password</h1>
        <label for="current-password">Current Password:</label>
        <input type="password" id="current-password" name="current-password" required>
    
        <label for="new-password">New Password:</label>
        <input type="password" id="new-password" name="new-password" required>
        
        <label for="confirm-password">Confirm New Password:</label>
        <input type="password" id="confirm-password" name="confirm-password" required>
    
        <button type="submit">Change Password</button>
    </form>
    <!-- Message container to display the result -->
    <div id="message-container"></div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form');
            const messageContainer = document.getElementById('message-container');

            form.addEventListener('submit', async function (event) {
                event.preventDefault();

                // Fetch the form data
                const formData = new FormData(form);

                // Submit the form using fetch
                const response = await fetch('/MyGestion-Ocp/change-password', {
                    method: 'POST',
                    body: formData,
                });

                // Parse the JSON response
                const result = await response.json();

                // Display the message in the message container
                messageContainer.textContent = result.message;

                // Clear the form after displaying the message
                form.reset();
            });
        });
    </script>
    

</body>

</html>
