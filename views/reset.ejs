<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Reset</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <style>
        body {
            background: #f5f5f5 url('../assets/img/brand/th3.jpeg') no-repeat center fixed;
            background-size: cover;
            margin: 0;
            height: 100%;
            font-family: Arial, sans-serif;
        }

        .text-center {
            padding-top: 20%; /* Adjusted padding for centering */
        }

        .container {
            width: 50%;
        }

        .title h1 {
            font-weight: bold;
            color: #ffffff; /* White text */
            margin-bottom: 10px; /* Added margin for space below the text */
        }

        .form-group {
            margin-bottom: 20px;
        }

        input.form-control {
            height: 40px;
            width: 100%;
            max-width: 100%;
            padding: 10px;
        }

        .btn-primary {
            background-color: #28a745; /* Green background color */
            border-color: #28a745;
            color: white;
            margin-top: 10px; /* Added margin to move the button down */
            border-radius: 10px; /* Added border-radius for a rounded button */
            width: 40%; /* Set the width of the button */
            font-weight: bold;

        }

        .btn-primary:hover {
            background-color: #218838; /* Darker green on hover */
            border-color: #218838;
            color: white;
        }

        .btn.btn-primary {
            padding: .4em 2em;
        }

        form {
            padding: 0 3em;
        }

        #reset-password-container {
            margin-top: 20px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="text-center">
        <div class="container">
            <div class="title pb-3">
                <h1>Password Reset</h1>
                <h2 style="color: #ffffff;">Merci de contacter l'admin</h2>

            </div>
            

            <!-- Additional information or links can be added here -->
            <div id="reset-password-container">
                <!-- Add any additional information or links here -->
            </div>
        </div>
    </div>
</body>
</html>
