<!DOCTYPE html>
<html lang="en">
<head>
   
  
    <style>
        /* Additional styles for responsiveness */
        body {
            font-size: 16px;
        }

        @media (max-width: 768px) {
            body {
                font-size: 14px;
            }
            /* Add more responsive styles as needed */
        }
        .sidenav-toggler {
            position: absolute;
            top: 15px; /* Adjust the top position as needed */
            right: 15px; /* Adjust the right position as needed */
            z-index: 1050;
        }
        .hadik {
        width: 150px;
        height: 100px;
        }
        /* Reset some default styles for the example */
        body {
            margin: 0;
            font-family: Arial, sans-serif;
        }

        .sidenav a {
    display: block;
    padding: 14px 16px;
