    text-decoration: none;
}

/* Navbar item styles on hover for all links except the first one */
.sidenav-nav li:not(:first-child) .nav-link:hover {
    background-color: #9f9a9a;
    color: rgb(128, 112, 112);
}
.brand-image {
    position: absolute;
    left: 0;
    margin-left: 40px; /* Optional margin for spacing */
    max-width: 200px; /* Maximum width of the image */
    max-height: 200px; /* Maximum height of the image */
    /* You can add additional styles as needed */
}


    </style>
</head>
