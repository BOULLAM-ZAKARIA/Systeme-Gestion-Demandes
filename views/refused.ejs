<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>les demandes refusées</title>

    <style>
         /* Hover effect */
    tbody tr:hover { /* Apply hover effect only to table rows */
            background-color: #ccc6c6; /* Your preferred hover color */
        }
  

.my-button2 {
    background-color: green;
    color: #fff;
    padding: 10px 15px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.3s; /* Adding a smooth transition effect */
}

/* Hover effect */
.my-button2:hover {
    background-color: #3c6e3e; /* Change the background color on hover */
}

/* Your button styles */
.my-button {
    background-color: #df2b2b;
    color: #fff;
    padding: 10px 15px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.3s; /* Adding a smooth transition effect */
}

/* Hover effect */
.my-button:hover {
    background-color: #931414; /* Change the background color on hover */
}

    </style>
</head>
<body>
    <div >
        <div class="container-fluid">
          <div class="header-body">
            <div class="row align-items-center py-4">
              <div class="col-lg-6 col-7">
                <h6 class="h2 text-white d-inline-block mb-0">Tables</h6>
                <nav aria-label="breadcrumb" class="d-none d-md-inline-block ml-md-4">
               
                </nav>
              </div>
             
            </div>
          </div>
        </div>
    <!-- Page content -->
  <div class="container-fluid mt--6">
    <div class="row">
      <div class="col">
        <div class="card">
          <!-- Card header -->
          <div class="card-header border-0">
            <h3 class="mb-0">Demandes refusées</h3>
          </div>
          <!-- Light table -->
          <div class="table-responsive">
            <table class="table align-items-center table-flush">
              <thead class="thead-light">
                <tr>
                  <th scope="col"  >Titre</th>
                  <th scope="col" >Motif de refus</th>
                  <th scope="col" >Date</th>
                  <th scope="col" >Demande</th>
                  <th scope="col">supprimer</th>
               
                </tr>
              </thead>
              <tbody id="demandeData">
                 <% demands.forEach(entry => { %>
                        <tr>
                            <td><%= entry.titre %></td>
                            <td><%= entry.commentaire %></td>
                            <td><%= entry.date_demande %></td>
                            
                            <td>
                              <button class="my-button2" onclick="viewPDF('<%= entry.iddemande %>')">Visualiser</button>
                            </td>
                            <td>
                              <button class="my-button" onclick="deleteDemand('<%= entry.iddemande %>')">Supprimer</button>
                            </td>
                            

                        </tr>
                    <% }); %>
              </tbody>
             </table>
             <script>
                function viewPDF(id) {
                fetch(`/MyGestion-Ocp/view-pdf/${id}`)
                    .then(response => response.blob())
                    .then(blob => {
                        // Handle the blob data to open the PDF, such as creating a URL and opening in a new tab
                        const file = new Blob([blob], { type: 'application/pdf' });
                        const fileURL = URL.createObjectURL(file);
                        window.open(fileURL); // Opens the PDF in a new tab
                    })
                    .catch(error => {
                        console.error('Error:', error);
                    });
                }
                function deleteDemand(id) {
                  if (confirm("Êtes-vous sûr de supprimer cette demande?")) {
                    fetch(`/MyGestion-Ocp/delete-demand/${id}`, {
                      method: 'DELETE',
                    })
                  .then(response => response.json())
                  .then(data => {
                  if (data.success) {
                      // Reload the page or update the table as needed
                      location.reload();
                    } else {
                      alert('Error deleting demand.');
                      }
                    })
                  .catch(error => {
                      console.error('Error:', error);
                    });
                  } 
                }
                                // Function to handle table search
                                function searchTable() {
                                    // Get the input value
                                    var input = document.getElementById('searchInput').value.toLowerCase();

                                    // Get the table rows
                                    var rows = document.getElementById('demandeData').getElementsByTagName('tr');

                                    // Loop through all table rows
                                    for (var i = 0; i < rows.length; i++) {
                                        // Get the title cell value (assuming it's the first cell in each row)
                                        var title = rows[i].getElementsByTagName('td')[0];

                                        // If the title contains the input value, show the row; otherwise, hide it
                                        if (title) {
                                            var titleText = title.textContent || title.innerText;
                                            if (titleText.toLowerCase().indexOf(input) > -1) {
                                                rows[i].style.display = '';
                                            } else {
                                                rows[i].style.display = 'none';
                                            }
                                        }
                                    }
                                }

                                // Attach an event listener to the input element
                                document.getElementById('searchInput').addEventListener('input', searchTable);               
            </script>     
     <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

</body>
</html>